@page "/"
@inject CharacterService CharacterService

<PageTitle>Search Demon Slayer API</PageTitle>

<h1>Search Demon Slayer API</h1>
<p>Pesquise e conheça os personagens de Demon Slayer.</p>

<div class="search">
    <input @bind="searchName" @bind:event="oninput"
           placeholder="Digite o nome de um personagem" />
    <button @onclick="Search">Buscar</button>
    <button @onclick="Clear">Limpar</button>
</div>

@if (loading)
{
    <p>Carregando personagens...</p>
}
else if (!string.IsNullOrEmpty(error))
{
    <p class="error">@error</p>
}
else if (characters.Count == 0)
{
    <p>Nenhum personagem encontrado.</p>
}
else
{
    <div class="characters">
        @foreach (var character in characters)
        {
            <div class="card" @key="character.Id">
                <img src="@character.Img" alt="@character.Name" />
                <h2>@character.Name</h2>
                <p><strong>Idade:</strong> @(character.Age?.ToString() ?? "Não informada")</p>
                <p><strong>Raça:</strong> @character.Race</p>
                <p><strong>Citação:</strong> @character.Quote</p>
            </div>
        }
    </div>

    @if (string.IsNullOrWhiteSpace(searchName))
    {
        <div class="pagination">
            <button @onclick="PreviousPage" disabled="@(currentPage == 1)">Anterior</button>
            <span>Página @currentPage de @totalPages</span>
            <button @onclick="NextPage" disabled="@(currentPage >= totalPages)">Próxima</button>
        </div>
    }
}

@code {
    private List<Character> characters = [];
    private string searchName = "";
    private int currentPage = 1;
    private int totalPages = 1;
    private bool loading = true;
    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadCharacters();
    }

    private async Task LoadCharacters()
    {
        loading = true;
        error = "";

        try
        {
            var result = await CharacterService.GetCharacters(currentPage);
            characters = result.Content;
            currentPage = result.Pagination.CurrentPage;
            totalPages = result.Pagination.TotalPages;
        }
        catch
        {
            error = "Não foi possível carregar os personagens. Verifique sua conexão e tente novamente.";
        }

        loading = false;
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(searchName))
        {
            currentPage = 1;
            await LoadCharacters();
            return;
        }

        loading = true;
        error = "";

        try
        {
            characters = await CharacterService.SearchCharacters(searchName.Trim());
        }
        catch
        {
            characters = [];
            error = "Não foi possível realizar a busca.";
        }

        loading = false;
    }

    private async Task Clear()
    {
        searchName = "";
        currentPage = 1;
        await LoadCharacters();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadCharacters();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadCharacters();
        }
    }
}
